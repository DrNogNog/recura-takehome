PORT=3000
JWT_SECRET=change-me

# Storage per workflow: "memory" (default, no setup) or "external" (needs the service running).
APPOINTMENTS_STORE=memory   # external = Cassandra
SUPPLIES_STORE=memory       # external = Postgres (also enables leader election)
FOOD_STORE=memory           # external = DynamoDB + Elasticsearch

DATABASE_URL=postgres://recura:recura@localhost:5432/recura
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_DC=datacenter1
DYNAMO_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
ELASTICSEARCH_URL=http://localhost:9200

# Demo admin tools (see and move every patient's time). Set to "off" outside demos.
DEMO_ADMIN=on

# Optional integrations
ANTHROPIC_API_KEY=          # AI meal planning with Claude; offline planner when empty
GOOGLE_API_KEY=             # Live "recent innovations" search; plain Google links when empty
GOOGLE_CSE_ID=
FOOD_MARKET_URLS=           # Comma-separated local market pages to scrape (JSON-LD products)
CDN_BASE_URL=
